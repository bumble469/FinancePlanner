generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////
// ENUMS
//////////////////////

enum AccountType {
  INDIVIDUAL
  COMPANY
  CLUB
}

enum WorkItemType {
  PROJECT
  EVENT
  PLAN
}

enum WorkItemStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum ExpenseCategory {
  SALARY
  MARKETING
  TOOLS
  OPERATIONS
  EVENT
  OTHER
}

enum MemberRole {
  ADMIN 
  CO_ADMIN
  MANAGER
  CO_MANAGER
  MEMBER 
}

enum MembershipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum IncomeType {
  INVESTMENT
  REVENUE
}

enum MilestoneStatus {
  UPCOMING
  IN_PROGRESS  
  ACHIEVED     
  MISSED    
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

//////////////////////
// AUTH / IDENTITY (unchanged)
//////////////////////

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  emailVerified DateTime?
  image         String?
  role          String    @default("user")

  account             Account?
  oauthAccount        OAuthAccount?
  refreshTokens       RefreshToken[]
  workItemMemberships WorkItemMember[]
  departmentMembers   DepartmentMember[]
  phaseMemberships    PhaseMember[]
  createdMilestones Milestone[] @relation("MilestoneCreator")
  sentInvitations WorkItemMemberInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model OAuthAccount {
  id                String  @id @default(cuid())
  userId            String  @unique
  provider          String
  providerAccountId String
  access_token      String?
  refresh_token     String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("oauth_accounts")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  revokedAt DateTime?
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

//////////////////////
// ACCOUNT (WORKSPACE)
//////////////////////

model Account {
  id     String      @id @default(uuid())
  userId String      @unique
  name   String
  type   AccountType

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItems WorkItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("accounts")
}

//////////////////////
// WORK ITEM (PROJECT / EVENT / PLAN)
//////////////////////

model WorkItem {
  id          String         @id @default(uuid())
  accountId   String
  name        String
  type        WorkItemType
  status      WorkItemStatus @default(ACTIVE)
  budget      Decimal?       @db.Decimal(12, 2) // overall budget set at creation
  currency    String         @default("USD")
  description String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // type-specific details
  project  Project?
  event    Event?
  planInfo PlanInfo?

  // collaboration
  members WorkItemMember[]
  invitations WorkItemMemberInvitation[]

  // departments and phases
  departments Department[]
  phases      Phase[]
  tasks       Task[]
  income     Income[]
  milestones Milestone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("work_items")
}

//////////////////////
// COLLABORATION
//////////////////////

model WorkItemMember {
  id         String     @id @default(uuid())
  workItemId String
  userId     String
  role       MemberRole @default(MEMBER)
  monthlyCost Decimal? @db.Decimal(12, 2)

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentMembers DepartmentMember[]
  phaseMembers      PhaseMember[]
  taskMembers TaskMember[]

  joinedAt DateTime @default(now())

  @@unique([workItemId, userId]) // user can't be added twice to same work item
  @@map("work_item_members")
}

model WorkItemMemberInvitation {
  id          String           @id @default(uuid())
  workItemId  String
  invitedById String
  email       String
  role        MemberRole       @default(MEMBER)
  status      MembershipStatus @default(PENDING)
  
  token       String           @unique
  expiresAt   DateTime
  respondedAt DateTime?

  workItem    WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  invitedBy   User @relation(fields: [invitedById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

//////////////////////
// DEPARTMENTS (formerly Role)
//////////////////////

model Department {
  id         String   @id @default(uuid())
  workItemId String
  name       String
  budget     Decimal? @db.Decimal(12, 2)

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  members  DepartmentMember[]
  expenses Expense[]

  phases Phase[]
  tasks  Task[]

  @@unique([workItemId, name])
  @@map("departments")
}

// which member is assigned to which department
model DepartmentMember {
  id               String @id @default(uuid())
  departmentId     String
  userId           String
  workItemMemberId String

  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItemMember WorkItemMember @relation(fields: [workItemMemberId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@map("department_members")
}

//////////////////////
// SPECIALIZED WORK ITEM TYPES
//////////////////////

model Project {
  workItemId  String    @id
  startDate   DateTime?
  endDate    DateTime?
  methodology String?

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@map("projects")
}

model Event {
  workItemId    String    @id
  venue         String?
  expectedCrowd Int?
  eventDate     DateTime?

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@map("events")
}

model PlanInfo {
  workItemId String  @id
  notes      String?

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@map("plan_info")
}

//////////////////////
// PHASES (formerly Module)
//////////////////////

model Phase {
  id         String    @id @default(uuid())
  workItemId String
  name       String
  startDate  DateTime?
  endDate    DateTime?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  expenses     Expense[]
  income       Income[]
  tasks        Task[]
  phaseMembers PhaseMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("phases")
}

model PhaseMember {
  id               String @id @default(uuid())
  phaseId          String
  userId           String
  workItemMemberId String

  phase          Phase          @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItemMember WorkItemMember @relation(fields: [workItemMemberId], references: [id], onDelete: Cascade)

  @@unique([phaseId, userId])
  @@map("phase_members")
}

//////////////////////
// FINANCIALS
//////////////////////

// merged Investment + Revenue into a single Income model
model Income {
  id          String     @id @default(uuid())
  workItemId  String                          
  phaseId     String?                         
  type        IncomeType
  amount      Decimal    @db.Decimal(12, 2)
  description String?
  source      String?                         
  receivedAt  DateTime   @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  phase    Phase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@map("income")
}

model Expense {
  id          String          @id @default(uuid())
  category    ExpenseCategory
  description String?
  amount      Decimal         @db.Decimal(12, 2)
  occurredAt  DateTime        @default(now())

  phaseId String?
  phase   Phase?  @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  loggedById String?

  createdAt DateTime @default(now())

  @@map("expenses")
}

model Milestone {
  id           String          @id @default(uuid())
  workItemId   String
  title        String
  description  String?
  dueDate      DateTime?       // soft deadline, optional
  status       MilestoneStatus @default(UPCOMING)
  achievedAt   DateTime?       // auto-set when all tasks done

  workItem   WorkItem    @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  tasks     MilestoneTask[]   // linked tasks
  createdBy String            // userId of creator
  creator     User   @relation("MilestoneCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("milestones")
}

model Task {
  id          String  @id @default(uuid())
  title       String
  description String?

  status TaskStatus @default(TODO)

  workItemId   String
  departmentId String?
  phaseId      String?

  dueDate     DateTime?   
  completedAt DateTime?   
  priority    Int         @default(0)  

  workItem   WorkItem    @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  phase      Phase?      @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  milestones   MilestoneTask[]
  members TaskMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tasks")
}

model TaskMember {
  id               String @id @default(uuid())
  taskId           String
  workItemMemberId String

  task           Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workItemMember WorkItemMember @relation(fields: [workItemMemberId], references: [id], onDelete: Cascade)

  @@unique([taskId, workItemMemberId])
  @@map("task_members")
}

model MilestoneTask {
  milestoneId String
  taskId      String

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([milestoneId, taskId])
  @@map("milestone_tasks")
}
