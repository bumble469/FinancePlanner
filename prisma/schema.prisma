generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////
// ENUMS
//////////////////////

enum AccountType {
  INDIVIDUAL
  COMPANY
  CLUB
}

enum WorkItemType {
  PROJECT
  EVENT
  PLAN
}

enum WorkItemStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum ExpenseCategory {
  SALARY
  MARKETING
  TOOLS
  OPERATIONS
  EVENT
  EQUIPMENT
  OTHER
}

enum MemberRole {
  ADMIN 
  CO_ADMIN
  MANAGER
  CO_MANAGER
  MEMBER 
}

enum MembershipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum IncomeType {
  REVENUE
  INVESTMENT
  SPONSORSHIP
  DONATION
  GRANT
  MERCHANDISE
  REFUND
  CLIENT_PAYMENT
  STALL_INCOME     
  OTHER
}

enum IncomeStatus {
    EXPECTED
    RECEIVED
    PARTIAL
    CANCELLED
}

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum ApprovalAction {
  APPROVED
  REJECTED
}

enum DocType {
  NOTE
  FILE
}

enum MilestoneStatus {
  UPCOMING
  IN_PROGRESS  
  ACHIEVED     
  MISSED    
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE               // legacy — no longer set by the app, kept for old rows
  SUBMITTED
  CHANGES_REQUESTED
  COMPLETED
}

enum NotificationScope {
  GENERAL
  PERSONAL
}

enum EmailNotificationScope {
  ALL
  SPECIFIC
}

enum NotificationType {
  INVITATION
  TASK_ASSIGNED
  TASK_CREATED
  TASK_COMPLETED
  TASK_SUBMITTED
  TASK_SUBMISSION_APPROVED
  TASK_SUBMISSION_REJECTED
  PERMISSIONS_UPDATED
  MILESTONE_CREATED
  MILESTONE_TASK_INCLUDED
  MILESTONE_UPDATED
  MEMBER_JOINED_DEPARTMENT
  INCOME_ADDED
  EXPENSE_REQUESTED
  EXPENSE_APPROVED
  EXPENSE_REJECTED
  DOCUMENT_UPLOADED
  EXTENSION_REQUESTED
  EXTENSION_APPROVED
  EXTENSION_REJECTED
  HARDWARE_REQUESTED
  HARDWARE_APPROVED
  HARDWARE_DECLINED
  HARDWARE_DEPOSIT_REFUNDED
  HARDWARE_CONDITION_UPDATED
}

enum ExtensionTargetType {
  TASK
  MILESTONE
}

enum ExtensionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EvidenceType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum HardwareCategory {
  AV
  FURNITURE
  ELECTRICAL
  STRUCTURAL
  IT
  OTHER
}

enum HardwareSource {
  OWNED
  RENTED
  BORROWED
}

enum HardwareRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum HardwareCondition {
  WORKING
  IN_USE
  BROKEN_DOWN
  PURCHASED   
  RETURNED
  LOST
}

// SUBSCRIPTION ENUMS
enum SubscriptionPlanCode {
  STARTER
  BASIC
  EMPLOYER
  MANAGER
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED
  PENDING
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PARTIAL
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  OVERDUE
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  MANUAL
}

//////////////////////
// AUTH / IDENTITY (unchanged)
//////////////////////

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  emailVerified DateTime?
  image         String?
  role          String    @default("user")

  emailNotificationsEnabled Boolean                @default(true)
  emailNotificationScope    EmailNotificationScope  @default(ALL)

  account             Account?
  oauthAccount        OAuthAccount?
  refreshTokens       RefreshToken[]
  workItemMemberships WorkItemMember[]
  departmentMembers   DepartmentMember[]
  phaseMemberships    PhaseMember[]
  createdMilestones Milestone[] @relation("MilestoneCreator")
  sentInvitations WorkItemMemberInvitation[]
  uploadedDocuments   WorkItemDocument[]
  notifications Notification[]
  emailNotificationPlans UserEmailNotificationPlan[]
  stallMembers StallMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model OAuthAccount {
  id                String  @id @default(cuid())
  userId            String  @unique
  provider          String
  providerAccountId String
  access_token      String?
  refresh_token     String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("oauth_accounts")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  revokedAt DateTime?
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

//////////////////////
// ACCOUNT (WORKSPACE)
//////////////////////

model Account {
  id     String      @id @default(uuid())
  userId String      @unique
  name   String
  type   AccountType

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItems WorkItem[]
  subscription Subscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("accounts")
}

//////////////////////
// WORK ITEM (PROJECT / EVENT / PLAN)
//////////////////////

model WorkItem {
  id          String         @id @default(uuid())
  accountId   String
  name        String
  type        WorkItemType
  status      WorkItemStatus @default(ACTIVE)
  budget      Decimal?       @db.Decimal(12, 2) // overall budget set at creation
  currency    String         @default("USD")
  description String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  project  Project?
  event    Event?
  planInfo PlanInfo?
  hasHardware Boolean @default(false)
  allowMultipleEditing Boolean @default(true)

  members WorkItemMember[]
  invitations WorkItemMemberInvitation[]

  // departments and phases
  departments Department[]
  phases      Phase[]
  tasks       Task[]
  income     Income[]
  expenses Expense[]
  milestones Milestone[]
  permissionAuditLogs PermissionAuditLog[]
  documents   WorkItemDocument[]
  notifications Notification[]
  emailNotificationSubscribers UserEmailNotificationPlan[]
  extensionRequests ExtensionRequest[]
  stalls      Stall[]         
  ticketTypes TicketType[]     
  ticketBookings TicketBooking[]
  hardwareItems HardwareItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("work_items")
}

//////////////////////
// COLLABORATION
//////////////////////

model WorkItemMember {
  id          String     @id @default(uuid())
  workItemId  String
  userId      String
  role        MemberRole @default(MEMBER)
  monthlyCost Decimal?   @db.Decimal(12, 2)
  permissions Json?

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentMembers DepartmentMember[]
  phaseMembers      PhaseMember[]
  taskMembers       TaskMember[]

  stallMembers           StallMember[]
  ticketAttendeeCheckins TicketAttendee[]
  uploadedEventQrs       Event[]

  permissionChangesMade     PermissionAuditLog[] @relation("ChangedBy")
  permissionChangesReceived PermissionAuditLog[] @relation("TargetMember")

  createdIncome Income[] @relation("IncomeCreator")

  requestedExpenses Expense[] @relation("ExpenseRequester")
  approvedExpenses  Expense[] @relation("ExpenseApprover")
  rejectedExpenses  Expense[] @relation("ExpenseRejector")

  taskNotes     TaskNote[]
  taskReactions TaskReaction[]
  milestoneExtensions MilestoneExtensionLog[]
  extensionRequestsMade     ExtensionRequest[] @relation("ExtensionRequester")
  extensionRequestsReviewed ExtensionRequest[] @relation("ExtensionReviewer")
  submissionsMade     TaskSubmission[] @relation("SubmissionSubmitter")
  submissionsReviewed TaskSubmission[] @relation("SubmissionReviewer")
  hardwareRequested HardwareItem[] @relation("HardwareRequestedBy")
  hardwareReviewed  HardwareItem[] @relation("HardwareReviewedBy")

  joinedAt DateTime @default(now())

  @@unique([workItemId, userId])
  @@map("work_item_members")
}

model WorkItemMemberInvitation {
  id          String           @id @default(uuid())
  workItemId  String
  invitedById String
  email       String
  role        MemberRole       @default(MEMBER)
  status      MembershipStatus @default(PENDING)
  
  token       String           @unique
  expiresAt   DateTime
  respondedAt DateTime?

  workItem    WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  invitedBy   User @relation(fields: [invitedById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PermissionAuditLog {
  id                  String   @id @default(uuid())
  workItemId          String
  targetMemberId      String   // whose permissions were changed
  changedById         String   // the WorkItemMember who made the change
  previousPermissions Json?
  newPermissions      Json
  createdAt           DateTime @default(now())

  workItem     WorkItem       @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  targetMember WorkItemMember @relation("TargetMember", fields: [targetMemberId], references: [id], onDelete: Cascade)
  changedBy    WorkItemMember @relation("ChangedBy", fields: [changedById], references: [id], onDelete: Cascade)

  @@index([workItemId, targetMemberId])
  @@map("permission_audit_logs")
}

//////////////////////
// DEPARTMENTS (formerly Role)
//////////////////////

model Department {
  id         String   @id @default(uuid())
  workItemId String
  name       String
  budget     Decimal? @db.Decimal(12, 2)

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  members  DepartmentMember[]
  income Income[]
  expenses Expense[]
  extensionRequests ExtensionRequest[]

  phases Phase[]
  tasks  Task[]
  documents   WorkItemDocument[]
  hardwareItems HardwareItem[]

  @@unique([workItemId, name])
  @@map("departments")
}

// which member is assigned to which department
model DepartmentMember {
  id               String @id @default(uuid())
  departmentId     String
  userId           String
  workItemMemberId String
  costShare        Decimal? @db.Decimal(12, 2)

  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItemMember WorkItemMember @relation(fields: [workItemMemberId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@map("department_members")
}

//////////////////////
// SPECIALIZED WORK ITEM TYPES
//////////////////////

model Project {
  workItemId  String    @id
  startDate   DateTime?
  endDate    DateTime?
  methodology String?

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@map("projects")
}

model Event {
  workItemId    String    @id
  venue         String?
  expectedCrowd Int?
  eventDate     DateTime?

  hasTicketing Boolean @default(false)
  hasStalls    Boolean @default(false)

  upiQrUrl          String?
  upiQrPath         String?
  upiQrUploadedById String?
  upiQrUpdatedAt    DateTime?

  workItem        WorkItem        @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  upiQrUploadedBy WorkItemMember? @relation(fields: [upiQrUploadedById], references: [id], onDelete: SetNull)

  @@map("events")
}

model PlanInfo {
  workItemId String  @id
  notes      String?

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@map("plan_info")
}

//////////////////////
// PHASES (formerly Module)
//////////////////////

model Phase {
  id         String    @id @default(uuid())
  workItemId String
  name       String
  startDate  DateTime?
  endDate    DateTime?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  expenses     Expense[]
  income       Income[]
  tasks        Task[]
  phaseMembers PhaseMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("phases")
}

model PhaseMember {
  id               String @id @default(uuid())
  phaseId          String
  userId           String
  workItemMemberId String

  phase          Phase          @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItemMember WorkItemMember @relation(fields: [workItemMemberId], references: [id], onDelete: Cascade)

  @@unique([phaseId, userId])
  @@map("phase_members")
}

//////////////////////
// FINANCIALS
//////////////////////

// merged Investment + Revenue into a single Income model
model Income {
  id String @id @default(uuid())

  workItemId   String
  phaseId      String?
  departmentId String?
  stallId      String? 
  hardwareItemId String?         

  type IncomeType

  amount Decimal? @db.Decimal(12,2)
  receivedAmount Decimal @default(0) @db.Decimal(12,2)

  status        IncomeStatus  @default(EXPECTED)
  paymentStatus PaymentStatus @default(PENDING)

  source      String?
  description String?

  receivedAt DateTime?
  createdAt  DateTime @default(now())

  createdById String?

  workItem   WorkItem    @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  phase      Phase?      @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  stall   Stall? @relation(fields: [stallId], references: [id], onDelete: SetNull)
  hardwareItem   HardwareItem? @relation(fields: [hardwareItemId], references: [id], onDelete: SetNull)

  createdBy WorkItemMember? @relation("IncomeCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workItemId])
  @@map("income")
}

model Expense {
  id           String @id @default(uuid())

  workItemId   String
  phaseId      String?
  departmentId String?
  stallId      String? 
  hardwareItemId String?

  category    ExpenseCategory
  description String?

  amount     Decimal @db.Decimal(12,2)
  paidAmount Decimal @default(0) @db.Decimal(12,2)

  status        ExpenseStatus @default(PENDING_APPROVAL)
  paymentStatus PaymentStatus @default(PENDING)

  requestedById String?
  approvedById  String?
  rejectedById  String?

  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  occurredAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime? @updatedAt

  workItem   WorkItem    @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  phase      Phase?      @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  stall   Stall? @relation(fields: [stallId], references: [id], onDelete: SetNull)
  hardwareItem   HardwareItem? @relation(fields: [hardwareItemId], references: [id], onDelete: SetNull)

  requestedBy WorkItemMember? @relation("ExpenseRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  WorkItemMember? @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy  WorkItemMember? @relation("ExpenseRejector", fields: [rejectedById], references: [id], onDelete: SetNull)

  @@index([workItemId])
  @@index([phaseId])
  @@index([departmentId])
  @@index([status])
  @@index([paymentStatus])
  @@map("expenses")
}

model Milestone {
  id           String          @id @default(uuid())
  workItemId   String
  title        String
  description  String?
  dueDate      DateTime?
  originalDueDate DateTime?    
  extensionReason String?
  status       MilestoneStatus @default(UPCOMING)
  achievedAt   DateTime?

  workItem   WorkItem    @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  tasks     MilestoneTask[]
  extensionLogs MilestoneExtensionLog[]
  extensionRequests ExtensionRequest[]
  
  createdBy String
  creator     User   @relation("MilestoneCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("milestones")
}

model MilestoneTask {
  milestoneId String
  taskId      String

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([milestoneId, taskId])
  @@unique([taskId])
  @@map("milestone_tasks")
}

model MilestoneExtensionLog {
  id              String   @id @default(uuid())
  milestoneId     String
  previousDueDate DateTime?
  newDueDate      DateTime
  reason          String
  extendedById    String?  
  createdAt       DateTime @default(now())

  milestone  Milestone       @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  extendedBy WorkItemMember? @relation(fields: [extendedById], references: [id], onDelete: SetNull)

  @@index([milestoneId])
  @@map("milestone_extension_logs")
}

model Task {
  id          String  @id @default(uuid())
  title       String
  description String?

  status TaskStatus @default(TODO)

  workItemId   String
  departmentId String?
  phaseId      String?

  startDate       DateTime?
  dueDate         DateTime?
  originalDueDate DateTime?  
  extensionReason String?
  completedAt     DateTime?
  priority        Int        @default(0)

  workItem   WorkItem    @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  phase      Phase?      @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  milestones   MilestoneTask[]
  members TaskMember[]
  notes     TaskNote[]
  reactions TaskReaction[]
  extensionRequests ExtensionRequest[]
  requirement TaskRequirement?
  submissions TaskSubmission[]

  dependsOn TaskDependency[] @relation("TaskDependent")
  blocks    TaskDependency[] @relation("TaskBlocker")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tasks")
}

model TaskDependency {
  id          String @id @default(uuid())
  taskId      String 
  dependsOnId String 

  task      Task @relation("TaskDependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskBlocker", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@map("task_dependencies")
}

model TaskMember {
  id               String @id @default(uuid())
  taskId           String
  workItemMemberId String

  task           Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workItemMember WorkItemMember @relation(fields: [workItemMemberId], references: [id], onDelete: Cascade)

  @@unique([taskId, workItemMemberId])
  @@map("task_members")
}

model TaskNote {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author WorkItemMember @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_notes")
}

model TaskReaction {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String
  emoji     String
  createdAt DateTime @default(now())

  task   Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author WorkItemMember @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([taskId, authorId])
  @@map("task_reactions")
}

model TaskRequirement {
  id        String   @id @default(uuid())
  taskId    String   @unique

  requireApproval            Boolean @default(true)
  requireDescription         Boolean @default(false)
  requireImages              Boolean @default(false)
  minImages                  Int?
  maxImages                  Int?
  requireVideo               Boolean @default(false)
  requireDocument            Boolean @default(false)
  allowMultipleEvidenceTypes Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_requirements")
}

model TaskSubmission {
  id            String           @id @default(uuid())
  taskId        String
  submittedById String
  description   String?
  status        SubmissionStatus @default(PENDING)

  reviewedById  String?
  reviewedAt    DateTime?
  reviewComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task        Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submittedBy WorkItemMember  @relation("SubmissionSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedBy  WorkItemMember? @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  files       TaskSubmissionFile[]

  @@index([taskId])
  @@index([status])
  @@map("task_submissions")
}

model TaskSubmissionFile {
  id           String       @id @default(uuid())
  submissionId String
  fileType     EvidenceType
  fileName     String
  filePath     String
  fileSize     Int
  mimeType     String
  createdAt    DateTime     @default(now())

  submission TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("task_submission_files")
}

//////////////////////
// DOCUMENTS & NOTES
//////////////////////

model WorkItemDocument {
  id           String       @id @default(uuid())
  workItemId   String
  departmentId String?      // optional — for dept-scoped visibility
  type         DocType
  title        String
  content      String?      // notes only
  fileUrl      String?      // Vercel Blob URL — files only
  fileName     String?
  fileSize     String?
  mimeType     String?
  uploadedById String?

  workItem     WorkItem    @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("work_item_documents")
}

model Notification {
  id         String            @id @default(uuid())
  workItemId String
  userId     String
  scope      NotificationScope
  type       NotificationType
  title      String
  message    String
  entityType String?
  entityId   String?
  isRead     Boolean           @default(false)
  createdAt  DateTime          @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workItemId, userId, isRead])
  @@map("notifications")
}

model UserEmailNotificationPlan {
  id         String   @id @default(uuid())
  userId     String
  workItemId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([userId, workItemId])
  @@map("user_email_notification_plans")
}

model ExtensionRequest {
  id         String              @id @default(uuid())
  workItemId String
  targetType ExtensionTargetType

  taskId      String?
  milestoneId String?

  departmentId String?

  currentDueDate   DateTime?
  requestedDueDate DateTime
  reason           String

  status ExtensionRequestStatus @default(PENDING)

  requestedById String
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?

  applyMode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workItem   WorkItem    @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  task       Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  milestone  Milestone?  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  requestedBy WorkItemMember  @relation("ExtensionRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  WorkItemMember? @relation("ExtensionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([workItemId])
  @@index([departmentId])
  @@index([status])
  @@map("extension_requests")
}

//////////////////////
// EVENT: STALLS (planning-level, not a vendor system)
//////////////////////

model Stall {
  id          String  @id @default(uuid())
  workItemId  String
  name        String
  description String?

  workItem WorkItem      @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  members  StallMember[]
  income   Income[]
  expenses Expense[]
  hardwareItems HardwareItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workItemId, name])
  @@map("stalls")
}

model StallMember {
  id               String @id @default(uuid())
  stallId          String
  userId           String
  workItemMemberId String

  stall          Stall          @relation(fields: [stallId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItemMember WorkItemMember @relation(fields: [workItemMemberId], references: [id], onDelete: Cascade)

  @@unique([stallId, userId])
  @@map("stall_members")
}

//////////////////////
// EVENT: TICKETING (fully separate ledger — booker/attendee detail)
//////////////////////

enum TicketBookingStatus {
  CONFIRMED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
}

model TicketType {
  id          String    @id @default(uuid())
  workItemId  String
  name        String
  price       Decimal   @db.Decimal(12, 2)
  capacity    Int?
  salesStart  DateTime?
  salesEnd    DateTime?
  description String?
  isActive    Boolean   @default(true)

  workItem WorkItem        @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  bookings TicketBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ticket_types")
}

model TicketBooking {
  id           String @id @default(uuid())
  workItemId   String
  ticketTypeId String

  bookedByName  String
  bookedByEmail String?
  bookedByPhone String?

  quantity      Int
  totalAmount   Decimal       @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(PENDING)
  status        TicketBookingStatus @default(CONFIRMED)
  bookingCode   String        @unique
  paymentMethod   PaymentMethod? 

  workItem   WorkItem         @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  ticketType TicketType       @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  attendees  TicketAttendee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workItemId])
  @@index([ticketTypeId])
  @@map("ticket_bookings")
}

model TicketAttendee {
  id            String    @id @default(uuid())
  bookingId     String
  name          String
  email         String?
  checkedIn     Boolean   @default(false)
  checkedInAt   DateTime?
  checkedInById String?

  booking       TicketBooking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  checkedInBy   WorkItemMember? @relation(fields: [checkedInById], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@map("ticket_attendees")
}

model HardwareItem {
  id         String @id @default(uuid())
  workItemId String
  name       String
  category   HardwareCategory
  source     HardwareSource
  quantity   Int    @default(1)
  vendor     String?
  notes      String?

  departmentId String?
  stallId      String?

  // approval workflow
  requestStatus  HardwareRequestStatus @default(PENDING)
  requestedById  String
  declineReason  String?
  reviewedById   String?
  reviewedAt     DateTime?

  // operational condition — set only after approval
  condition HardwareCondition?

  // rental specifics
  rentalStart       DateTime?
  rentalEnd         DateTime?
  monthlyRentAmount Decimal?  @db.Decimal(12, 2)
  lastBilledAt      DateTime?
  depositAmount     Decimal?  @db.Decimal(12, 2)
  depositReturned   Boolean   @default(false)

  workItem    WorkItem        @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  department  Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  stall       Stall?          @relation(fields: [stallId], references: [id], onDelete: SetNull)
  requestedBy WorkItemMember  @relation("HardwareRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  WorkItemMember? @relation("HardwareReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  expenses    Expense[]
  income   Income[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hardware_items")
}


// SUBSCRIPTION MODELS

model SubscriptionPlans{
  id String @id @default(uuid())
  code SubscriptionPlanCode @unique

  name        String
  description String?

  isActive Boolean @default(true)
  isPublic Boolean @default(true)

  // Work item limits
  maxProjects       Int
  maxEvents         Int
  maxTotalWorkItems Int?

  // Optional future limits
  maxMembersPerWorkItem Int?
  maxStorageBytes        BigInt?
  maxDepartments         Int?
  maxTasksPerWorkItem    Int?

  features Json?

  prices        PlanPrice[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription_plans")
}

model PlanPrice {
  id String @id @default(uuid())

  planId String
  plan   SubscriptionPlans @relation(fields: [planId], references: [id], onDelete: Cascade)

  currency String
  billingInterval BillingInterval

  amount Decimal @db.Decimal(12, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@unique([planId, currency, billingInterval])
  @@index([currency, billingInterval])

  @@map("plan_prices")
}

model Subscription {
  id String @id @default(uuid())

  accountId String @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  planId String
  plan   SubscriptionPlans @relation(fields: [planId], references: [id])

  priceId String
  price   PlanPrice @relation(fields: [priceId], references: [id])

  status SubscriptionStatus @default(PENDING)

  billingInterval BillingInterval
  currency        String

  amount Decimal @db.Decimal(12, 2)

  startedAt       DateTime
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  cancelAtPeriodEnd Boolean @default(false)
  cancelledAt       DateTime?
  endedAt           DateTime?

  providerCustomerId     String?
  providerSubscriptionId String?

  payments SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([currentPeriodEnd])

  @@map("subscriptions")
}

model SubscriptionPayment {
  id String @id @default(uuid())

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  provider PaymentProvider

  currency String
  amount   Decimal @db.Decimal(12, 2)

  status PaymentStatus @default(PENDING)

  providerOrderId   String? @unique
  providerPaymentId String? @unique

  failureReason String?
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId])
  @@index([status])

  @@map("subscription_payments")
}